#!/bin/bash
set -e
cd "$(dirname "$0")"
echo "玄姝 Agent 启动中..."

# 检测 Docker
if command -v docker &>/dev/null; then
    docker compose up -d 2>/dev/null || { docker build -t xuanshu-agent . && docker run -d -p 8901:8901 --name xuanshu xuanshu-agent; }
    echo "已启动 → http://localhost:8901"
    exit 0
fi

# 检测 Python
PYTHON=""
for cmd in python3 python; do
    if command -v "$cmd" &>/dev/null && "$cmd" -c "import sys; sys.exit(0 if sys.version_info>=(3,8) else 1)" 2>/dev/null; then
        PYTHON="$cmd"
        break
    fi
done
[ -z "$PYTHON" ] && echo "错误: 需要 Python 3.8+ 或 Docker" && exit 1
echo "Python: $PYTHON ($($PYTHON --version 2>&1))"

# 安装依赖（多源轮询 + 超时控制，一个源卡住就换下一个，避免长时间卡死）
echo "安装依赖（多源轮询，失败自动切换）..."
SOURCES=(
  "https://pypi.tuna.tsinghua.edu.cn/simple"
  "https://mirrors.aliyun.com/pypi/simple"
  "https://mirrors.cloud.tencent.com/pypi/simple"
  "https://repo.huaweicloud.com/repository/pypi/simple"
  "https://pypi.mirrors.ustc.edu.cn/simple"
  "https://pypi.org/simple"
)
INSTALL_OK=0
for src in "${SOURCES[@]}"; do
  echo "→ 尝试源: $src"
  if $PYTHON -m pip install -r requirements.txt \
      -i "$src" \
      --timeout=10 --retries=1 \
      --disable-pip-version-check; then
    INSTALL_OK=1
    break
  fi
  echo "→ 该源失败或超时，切换下一个源..."
done
[ "$INSTALL_OK" = "1" ] || {
    echo "所有源均失败，请检查网络后手动运行: $PYTHON -m pip install -r requirements.txt"
    exit 1
}

# 验证核心依赖
MISSING=""
for mod in flask requests openai pypdf PIL edge_tts; do
    $PYTHON -c "import $mod" 2>/dev/null || MISSING="$MISSING $mod"
done
if [ -n "$MISSING" ]; then
    echo "警告: 以下模块未安装:$MISSING"
    echo "可用功能可能受限，尝试继续启动..."
fi

echo "已启动 → http://localhost:8901（按 Ctrl+C 退出）"
$PYTHON frontend.py
