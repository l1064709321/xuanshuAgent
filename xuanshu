#!/bin/bash
set -e
cd "$(dirname "$0")"
echo "玄姝 Agent 启动中..."

# 检测 Docker
if command -v docker &>/dev/null; then
    docker compose up -d 2>/dev/null || { docker build -t xuanshu-agent . && docker run -d -p 8901:8901 --name xuanshu xuanshu-agent; }
    echo "已启动 → http://localhost:8901"
    exit 0
fi

# 检测 Python
PYTHON=""
for cmd in python3 python; do
    if command -v "$cmd" &>/dev/null && "$cmd" -c "import sys; sys.exit(0 if sys.version_info>=(3,8) else 1)" 2>/dev/null; then
        PYTHON="$cmd"
        break
    fi
done
[ -z "$PYTHON" ] && echo "错误: 需要 Python 3.8+ 或 Docker" && exit 1
echo "Python: $PYTHON ($($PYTHON --version 2>&1))"

# 安装依赖（先试镜像，失败用官方源）
echo "安装依赖..."
$PYTHON -m pip install -r requirements.txt -q -i https://pypi.tuna.tsinghua.edu.cn/simple 2>/dev/null || \
$PYTHON -m pip install -r requirements.txt -q || {
    echo "pip 安装失败，请手动运行: $PYTHON -m pip install -r requirements.txt"
    exit 1
}

# 验证
$PYTHON -c "import flask" 2>/dev/null || { echo "错误: Flask 安装失败"; exit 1; }

echo "已启动 → http://localhost:8901"
$PYTHON frontend.py
