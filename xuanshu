#!/bin/bash
# 玄姝 Agent — 一键启动（Docker 全量依赖）
set -e

log() { echo "[玄姝] $*"; }

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_DIR"

echo "╔══════════════════════════════════════╗"
echo "║       玄姝 Agent 启动中...          ║"
echo "╚══════════════════════════════════════╝"

# === 1. 检测并自动安装 Docker ===
if ! command -v docker &>/dev/null; then
    log "未检测到 Docker，正在自动安装..."
    if command -v apt &>/dev/null; then
        # 优先走系统源（Aidlux/Ubuntu/Debian 直装，避开 get.docker.com 被墙）
        sudo apt update && sudo apt install -y docker.io || {
            log "系统源安装失败，尝试官方脚本..."
            curl -fsSL https://get.docker.com | sh
        }
    elif command -v yum &>/dev/null; then
        sudo yum install -y docker && sudo systemctl start docker
    else
        log "无法识别包管理器，请手动安装 Docker: https://docs.docker.com/engine/install/"
        exit 1
    fi
    log "Docker 安装完成"
fi

# === 2. 构建并启动 ===
if command -v docker-compose &>/dev/null; then
    docker-compose up -d
elif docker compose version &>/dev/null 2>&1; then
    docker compose up -d
else
    log "构建镜像..."
    docker build -t xuanshu-agent .
    log "启动容器..."
    docker rm -f xuanshu 2>/dev/null || true
    docker run -d -p 8901:8901 --name xuanshu xuanshu-agent
fi

log "服务已启动 → http://localhost:8901"
log "查看日志: docker logs -f xuanshu"
