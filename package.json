{
  "name": "xuanshu-agent",
  "version": "0.0.5",
  "description": "玄姝 (Xuanshu) — 多 Agent 协作系统：TS + Fastify 全量迁移版，含子 Agent、工具链、记忆系统、技能市场、SSE 流式思考链",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "xuanshu": "bin/xuanshu.js"
  },
  "files": [
    "bin",
    "dist",
    "index.html",
    "style.css",
    "sandbox.py",
    "pdf_tools.py",
    "tts_tools.py",
    "data_tools.py",
    "src/scripts",
    "README.md",
    "LICENSE",
    "LICENSE-apache"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && npm pack"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "ai",
    "mult-agent",
    "llm",
    "fastify",
    "typescript",
    "skill",
    "memory",
    "tts",
    "sse"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/l1064709321/xuanshuAgent.git"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^8.0.3",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^7.4.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
