#!/bin/bash
# 玄姝 Agent — 一键启动脚本（Docker 模式）
set -e

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_DIR"

echo "╔══════════════════════════════════════╗"
echo "║       玄姝 Agent 启动中...          ║"
echo "╚══════════════════════════════════════╝"

# === 检测 Docker ===
if ! command -v docker &>/dev/null; then
    echo "[玄姝] 未检测到 Docker，请先安装："
    echo ""
    echo "  # Debian / Ubuntu / Aidlux"
    echo "  curl -fsSL https://get.docker.com | sh"
    echo ""
    echo "  # CentOS / TencentOS"
    echo "  sudo yum install -y docker && sudo systemctl start docker"
    echo ""
    echo "  # 安装后把当前用户加入 docker 组（免 sudo）"
    echo "  sudo usermod -aG docker \$USER && newgrp docker"
    echo ""
    echo "  装好后重新执行: bash xuanshu"
    exit 1
fi

# === 启动 Docker ===
if command -v docker-compose &>/dev/null; then
    docker-compose up -d
elif docker compose version &>/dev/null 2>&1; then
    docker compose up -d
else
    docker build -t xuanshu-agent .
    docker run -d -p 8901:8901 --name xuanshu xuanshu-agent
fi

echo "[玄姝] 服务已启动 (端口 8901)"
echo "[玄姝] 日志: docker logs -f xuanshu"
